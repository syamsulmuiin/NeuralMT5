# NeuralMT5 single configuration source
TRADING_MODE=analysis
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_MAGIC_NUMBER=2601001
MT5_ORDER_COMMENT=NeuralMT5

SYMBOLS=XAUUSD,EURUSD
SYMBOL_XAUUSD=
SYMBOL_EURUSD=
MIN_SYMBOL_RESOLUTION_CONFIDENCE=0.90
SYMBOL_EXCLUDE_TOKENS=REPLAY,REPALY,PLAYBACK

HTF=M15
MTF=M5
LTF=M1
HTF_WINDOW=200
MTF_WINDOW=200
LTF_WINDOW=200
MAX_STALE_TICK_SECONDS=5
MAX_MISSING_CANDLE_RATIO=0.01
ATR_PERIOD=14
MOMENTUM_PERIOD=10
VOLATILITY_PERIOD=20
STRUCTURE_PIVOT_LEFT=2
STRUCTURE_PIVOT_RIGHT=2
REGIME_LOOKBACK=20
ORDERFLOW_LOOKBACK=20

NETWORK_TYPE=cnn_gru
HIDDEN_SIZE=64
DROPOUT=0.20
LEARNING_RATE=0.001
BATCH_SIZE=64
EPOCHS=30
RANDOM_SEED=42
# Number of most-recent CLOSED candles fetched PER timeframe for training.
# This is not a calendar-day count. Exact UTC ranges used are written to
# storage/reports/training_data_diagnostics.json and training_report.json.
TRAIN_HISTORY_BARS=5000
LABEL_HORIZON_BARS=30
TRAIN_MIN_SAMPLES=300
TRAIN_MIN_BALANCED_ACCURACY=0.34
TRAIN_MIN_CLASS_SAMPLES=20
TRAIN_CLASS_WEIGHT_POWER=0.50
TRAIN_CLASSIFICATION_LOSS_WEIGHT=1.00
TRAIN_QUALITY_LOSS_WEIGHT=0.25
TRAIN_EXCURSION_LOSS_WEIGHT=0.25
TRAIN_EARLY_STOPPING_PATIENCE=5
TRAIN_EARLY_STOPPING_MIN_DELTA=0.001

# BACKTEST
BACKTEST_HISTORY_BARS=5000
BACKTEST_INITIAL_EQUITY=10000
DATASET_VERSION=dataset-v1
MODEL_ARTIFACT_PATH=storage/models/champion.pt
SCALER_ARTIFACT_PATH=storage/scalers/champion.json

# RUNTIME INTEGRATION
RUNTIME_LOOP_SECONDS=1.0
MT5_RECONNECT_ATTEMPTS=3
MT5_RECONNECT_DELAY_SECONDS=2.0

W_HTF=0.14
W_MTF=0.14
W_LTF=0.14
W_STRUCTURE=0.14
W_ORDERFLOW=0.10
W_REGIME=0.10
W_MOMENTUM=0.10
W_NEURAL=0.14
MIN_DIRECTION_SCORE=0.60
MIN_DIRECTION_MARGIN=0.15
MIN_BRAINFLOW_SCORE=0.65
MIN_CONFIDENCE=0.60

MIN_RR=1.50
ATR_SL_MULTIPLIER=1.20
ATR_TP_MULTIPLIER=1.80

RISK_PER_TRADE=0.005
MAX_DAILY_RISK=0.020
MAX_DAILY_LOSS=0.020
MAX_CONSECUTIVE_LOSSES=4
MAX_OPEN_POSITIONS=3
MAX_TOTAL_EXPOSURE=0.030
MAX_CORRELATED_EXPOSURE=0.015

MAX_SPREAD_POINTS=50
MAX_SLIPPAGE_POINTS=20

TRADING_TIMEZONE=UTC
TRADING_SESSION_START=00:00
TRADING_SESSION_END=23:59
NO_NEW_ENTRY_AFTER=23:30
FORCE_FLAT_TIME=23:55

RETRAIN_ENABLED=true
SHADOW_MODE_ENABLED=true
AUTO_PROMOTION_ENABLED=false
PURGE_BARS=30
EMBARGO_BARS=30
MIN_CHALLENGER_TRADES=100
MAX_ALLOWED_DRAWDOWN=0.15
MIN_EXPECTANCY_R=0.00

DATABASE_URL=sqlite:///storage/database/neuralmt5.db
LOG_LEVEL=INFO

DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_AUTH_TOKEN=
DASHBOARD_REMOTE_ACCESS_ENABLED=false
DASHBOARD_TRUST_HTTPS_PROXY=false
DASHBOARD_RATE_LIMIT_PER_MINUTE=120
DASHBOARD_DOCS_ENABLED=false

# PHASE 7 LIVE-READINESS (keep false until verified on the actual MT5 host)
LIVE_EXECUTION_ENABLED=false
LIVE_READINESS_ACKNOWLEDGED=false
LIVE_REQUIRE_TERMINAL_TRADE_ALLOWED=true
LIVE_REQUIRE_ACCOUNT_TRADE_ALLOWED=true
LIVE_MAX_CLOCK_SKEW_SECONDS=30
LIVE_FAULT_INJECTION_PASSED=false
LIVE_SOAK_TEST_PASSED=false
